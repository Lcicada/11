  "QTNicRdmaTest": {
    "Desc": "NIC RDMA TEST",
    "Tags": "NIC RDMA TEST",
    "Module": "nic_rdma_test",
    "Class": "NicRdmaTest",
    "Function": "test_nic_rdma",
    "Timeout": "120m",
    "Args": [],
    "Kwargs": {
      "test_seconds": 900,
      "device_ids": [
        "mlx5_0",
        "mlx5_1"
      ],
      "spec": {
        "BW average[Gb/sec]": 90
      },
      "Total BW average": 90,
      "tool_name": "ib_write_bw",
      "tool_parameter": "-d {device_id}  -p {port} -q 8 --report_gbits -F -D 30 --run_infinitely",
      "start_port": 1000
    }
  },
