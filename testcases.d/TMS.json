	"QtTmsPerformanceTest_Parallel": {
		"Desc": "",
		"Tags": "Tms Performance Test",
		"Module": "tms_performance_test",
		"Class": "TmsPerformanceTest",
		"Function": "test_tms_performance",
		"Timeout": "720m",
		"Args": [],
		"Kwargs": {
			"mode": "parallel",
			"interval_time": 30,
			"case_cmd": {
				"dec_h264_8k": "mts_video enable transPerf dec_h264_8k all all 3600 --device {id} --extra_args='--threads 52' --extra_timeout 100000000 > dec_h264_8k_{id}.log 2>&1 &",
				"dec_vp9_8k_10bit": "mts_video enable transPerf dec_vp9_8k_10bit all all 3600 --device {id} --extra_args='--threads 24' --extra_timeout 100000000 > dec_vp9_8k_10bit_{id}.log 2>&1 &",
				"trans_hevc_1080p_massive_bird": "mts_video enable transPerf trans_hevc_1080p_massive_bird all all 3600 --device {id} --extra_args='--threads 90' --extra_timeout 100000000 > trans_hevc_1080p_massive_bird_{id}.log 2>&1 &",
				"trans_av1_720p_10to8bit": "mts_video enable transPerf trans_av1_720p_10to8bit all all 3600 --device {id} --extra_args='--threads 160' --extra_timeout 100000000 > trans_av1_720p_10to8bit_{id}.log 2>&1 &"
			}
		}
	},
