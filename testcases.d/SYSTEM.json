  "QtSmartnicSetUart0": {
        "Desc": "set uart to bmc channel",
        "Tags": "",
        "Module": "execute_command",
        "Class": "ExecuteCommand",
        "Function": "test_execute_command",
        "Timeout": "5m",
        "Args": [],
        "Kwargs": {
            "cmd": "ipmitool raw 0x32 0x6d 00 && ipmitool mc reset cold && sleep 180 && ipmitool raw 0x32 0x6e"
        }
    },
  "QtSmartnicSetUart1": {
        "Desc": "set uart to bios channel",
        "Tags": "",
        "Module": "execute_command",
