        "Function": "test_execute_command",
        "Timeout": "5m",
        "Args": [],
        "Kwargs": {
            "cmd": "ipmitool raw 0x32 0x6d 01 && ipmitool mc reset cold && sleep 180 && ipmitool raw 0x32 0x6e"
        }
    },
  "QtSmartnicStaticIP": {
        "Desc": "set bf3 static ip",
        "Tags": "",
        "Module": "execute_command",
        "Class": "ExecuteCommand",
        "Function": "test_execute_command",
        "Timeout": "5m",
        "Args": [],
        "Kwargs": {
            "cmd": "ip link add link oob_net0 name oob_net0.200 type vlan id 200; ip addr add 192.168.1.1/24 brd 192.168.1.255 dev oob_net0.200; ip link set dev oob_net0.200 up"
        }
    }
