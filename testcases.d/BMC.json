  "QtBmcEepromSetting_Set": {
    "Desc": "",
    "Tags": "BMC EEPROM Setting",
    "Module": "bmc_eeprom_setting",
    "Class": "BmcEepromSetting",
    "Function": "test_bmc_eeprom_setting",
    "Timeout": "5m",
    "Args": [],
    "Kwargs": {
      "action": "set",
      "i2c_expand_cmd": "ipmitool -I lanplus -H {} -U toutiao -P 'toutiao!@#' -p 8623 raw 0x3a 0x98 0x01",
      "set_box_cmd": {
        "4NVMEs_4NICs": "ipmitool -I lanplus -H {} -U toutiao -P 'toutiao!@#' -p 8623 raw 0x3a 0xcb 0xdd 0xb3 0x00 0x55 0x55",
        "4NVMEs_8NICs": "ipmitool -I lanplus -H {} -U toutiao -P 'toutiao!@#' -p 8623 raw 0x3a 0xcb 0xdd 0xb3 0x00 0x55 0xff",
        "8NVMEs_4NICs": "ipmitool -I lanplus -H {} -U toutiao -P 'toutiao!@#' -p 8623 raw 0x3a 0xcb 0xdd 0xb3 0x00 0xff 0x55",
        "8NVMEs_8NICs": "ipmitool -I lanplus -H {} -U toutiao -P 'toutiao!@#' -p 8623 raw 0x3a 0xcb 0xdd 0xb3 0x00 0xff 0xff"
      },
      "check_box_bmc_cmd": "ipmitool -I lanplus -H {} -U toutiao -P 'toutiao!@#' -p 8623 raw 0x06 0x52 0x01 0xa2 0x02 0x02 0x83",
      "expect_value": {
        "4NVMEs_4NICs": "55 55",
        "4NVMEs_8NICs": "55 ff",
        "8NVMEs_4NICs": "ff 55",
        "8NVMEs_8NICs": "ff ff"
      }
    }
  },
