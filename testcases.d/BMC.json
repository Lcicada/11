  "QtMbBmcsettingsCheck_Devnumber": {
    "Desc": "",
    "Tags": "BMC INFO",
    "Module": "bmc_fun_test",
    "Class": "Bmctest",
    "Function": "test_dev_number",
    "Timeout": "5m",
    "Args": [],
    "Kwargs": {
      "CPU": {
        "set": "ipmitool raw 0x3e 0x2d 0x02 {dev_num}",
        "check": "ipmitool raw 0x3e 0x2e 0x02 |awk -F\" \" '{print $2}'",
        "mapping": {
          "1": "0x01",
          "2": "0x03"
        }
      },
      "PSU": {
        "set": "ipmitool raw 0x3e 0x2d 0x00 {dev_num}",
        "check": "ipmitool raw 0x3e 0x2e 0x00 |awk -F\" \" '{print $2}'"
      }
    }
  },
