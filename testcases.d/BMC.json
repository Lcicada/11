  "QtBmcMacCheck": {
    "Desc": "",
    "Tags": "BMC INFO",
    "Module": "bmc_fun_test",
    "Class": "Bmctest",
    "Function": "test_bmc_mac",
    "Timeout": "5m",
    "Args": [],
    "Kwargs": {
      "ip_test_cmd": "ipmitool lan print",
      "dedicate_mac_cmd": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xa0 8 0x10 0x00",
      "share_mac_cmd": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xa0 8 0x10 0x08",
      "ip_address_exp": "10",
      "ip_address_source_exp": "DHCP Address",
      "factory_mode": {
        "enter": "ipmitool raw 0x3a 0xa1 0xdd 0xb3 0x00 0x4d 0x43 0x52 0x81",
        "exit": "ipmitool raw 0x3a 0xa1 0xdd 0xb3 0x00 0x4d 0x43 0x52 0x00",
        "exit_check": "ipmitool raw 0x3a 0xa2 0xdd 0xb3 0x00",
        "exit_mode_exp": "00",
        "channel": {
          "switch": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xe0 0 0x40",
          "release": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xe0 0 0"
        }
      }
    }
  },
  "QtBmcMacCheck_Static": {
    "Desc": "",
    "Tags": "BMC INFO",
    "Module": "bmc_fun_test",
    "Class": "Bmctest",
    "Function": "test_bmc_mac",
    "Timeout": "8m",
    "Args": [],
    "Kwargs": {
      "ip_test_cmd": "ipmitool lan print",
      "dedicate_mac_cmd": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xa0 8 0x10 0x00",
      "share_mac_cmd": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xa0 8 0x10 0x08",
      "ip_address_exp": "192",
      "ip_address_source_exp": "Static Address",
      "factory_mode": {
        "enter": "ipmitool raw 0x3a 0xa1 0xdd 0xb3 0x00 0x4d 0x43 0x52 0x81",
        "exit": "ipmitool raw 0x3a 0xa1 0xdd 0xb3 0x00 0x4d 0x43 0x52 0x00",
        "exit_check": "ipmitool raw 0x3a 0xa2 0xdd 0xb3 0x00",
        "exit_mode_exp": "00",
        "channel": {
          "switch": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xe0 0 0x40",
          "release": "ipmitool raw 0x3A 0xa9 0xdd 0xb3 0x00 15 0xe0 0 0"
        }
      }
    }
  },
  "QtBmcDuidCheck": {
    "Desc": "",
    "Tags": "BMC INFO",
    "Module": "bmc_fun_test",
    "Class": "Bmctest",
    "Function": "test_ipv6_duid",
    "Timeout": "5m",
    "Args": [],
    "Kwargs": {
      "read_bmc_mac_cmd": "ipmitool lan print 1 | grep 'MAC Address' | awk '{print$4}' | tr [a-z] [A-Z] | sed 's/://g'",
      "read_lan6_cmd": "ipmitool lan6 print 1 | grep -A 1 'DUID' | tail -1 | cut -b 15-26 | tr [a-z] [A-Z]",
      "need_to_cmp": "on"
    }
  },
