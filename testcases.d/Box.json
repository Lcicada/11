    "Class": "Nvidiagpudcgm",
    "Function": "test_gpu_dcgm",
    "Timeout": "180m",
    "Args": [],
    "Kwargs": {
      "pre_step": {
        "install_rpm_cmd": [
          "dpkg -i datacenter-gpu-manager_3.3.6_amd64.deb"
        ],
        "load_gpu_driver_cmd": [
          "nv-hostengine"
        ],
        "persistence_mode_enable": true,
        "persistence_mode_after_test_disable": true,
        "persistence_mode_enable_cmd": "nvidia-smi -pm 1",
        "persistence_mode_disable_cmd": "nvidia-smi -pm 0",
        "start_service_cmd": [
          "nv-fabricmanager"
        ]
      },
      "tool_para": "diag -r 4 -p memtest.test0=true\\;memtest.test1=true\\;memtest.test2=true\\;memtest.test3=true\\;memtest.test4=true\\;memtest.test5=true\\;memtest.test6=true\\;memtest.test7=true\\;memtest.test8=true\\;memtest.test9=true\\;memtest.test10=true\\;memtest.test_duration=3600",
      "golden_file": "gpu_dcgm_specs_donghu.json"
    }
  },
