    "QtCpuFunctionTest_UpiStress": {
        "Desc": "",
        "Tags": "",
        "Module": "upi_stress",
        "Class": "UPIStress",
        "Function": "test_upi_stress",
        "Timeout": "5m",
        "Args": [],
        "Kwargs": {
            "ready_cmd": "modprobe msr;ulimit -n 10000;echo 0 > /proc/sys/kernel/nmi_watchdog",
            "pcm_cmd": "./pcm.x 1 -i=1",
            "mlc_version": "mlcv3.9",
            "stress_time": 60,
            "time_interval": 2,
            "sockets_num": 2,
            "upi_ports_per_socket": 3,
            "link_precent_limit":  {
                "70": ["6519"],
                "90": ["6743"]
            },
            "spec_file": "upi_stress_specs.json"
        }
    },
    "QtCpuFunctionTest_UpiCheck": {
        "Desc": "",
        "Tags": "",
        "Module": "upi_check",
