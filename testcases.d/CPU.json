        "Function": "test_upi_check",
        "Timeout": "5m",
        "Args": [],
        "Kwargs": {
            "pcm_tool": "pcm.x",
            "pcm_cmd": "./pcm.x 1 -nc -ns -i=1",
            "ready_cmd": "modprobe msr;echo 0 > /proc/sys/kernel/nmi_watchdog",
            "spec_file": "upi_check_specs.json"
        }
    },
