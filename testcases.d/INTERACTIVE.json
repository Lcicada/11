    "QtPSUREDUNDANT": {
        "Desc": "host psu redundant test ",
        "Tags": "PromptBox",
        "Module": "interactive_test",
        "Class": "Interactive",
        "Function": "test_psu_redundant",
        "Timeout": "360m",
        "Args": [],
        "Kwargs": {
            "cmd": "ipmitool ",
            "HOST_PSU0_unplug": {
                    "device":"HOST",
                    "prompt_name":"PSU_CABLE",
                    "para" :"PlugOut",
                    "sub_para":"",
                    "flag":"PSU0",
                    "sel_keyword":["0x6e | Power Supply AC lost | Asserted"],
                    "sdr_golden":{
                        "PSU0_PIn": {
                            "sensor_status": {
                                "lower_operator": "==",
                                "lower_limit": "ok"
                            },
                            "sensor_value": {
                                "lower_operator": "==",
                                "lower_limit": 0
                            }
                        }
                    },
                    "delay_time":25
                },
            "HOST_PSU0_plug": {
                    "device":"HOST",
                    "prompt_name":"PSU_CABLE",
                    "para" :"PlugIn",
                    "sub_para":"",
                    "flag":"PSU0",
                    "sel_keyword":["0x6e | Power Supply AC lost | Deasserted"],
                    "sdr_golden":{
                        "PSU0_PIn": {
                            "sensor_status": {
                                "lower_operator": "==",
                                "lower_limit": "ok"
                            },
                            "sensor_value": {
                                "lower_operator": ">",
                                "lower_limit": 100
                            }
                        }
                    },
                    "delay_time":125
                },
                    "HOST_PSU1_unplug": {
                    "device":"HOST",
                    "prompt_name":"PSU_CABLE",
                    "para" :"PlugOut",
                    "sub_para":"",
                    "flag":"PSU1",
                    "sel_keyword":["0x6f | Power Supply AC lost | Asserted"],
                    "sdr_golden":{
                        "PSU1_PIn": {
                            "sensor_status": {
                                "lower_operator": "==",
                                "lower_limit": "ok"
                            },
                            "sensor_value": {
                                "lower_operator": "==",
                                "lower_limit": 0
                            }
                        }
                    },
                    "delay_time":25
                },
                    "HOST_PSU1_plug": {
                    "device":"HOST",
                    "prompt_name":"PSU_CABLE",
                    "para" :"PlugIn",
                    "sub_para":"",
                    "flag":"PSU1",
                    "sel_keyword":["#0x6f | Power Supply AC lost | Deasserted"],
                    "sdr_golden":{
                        "PSU1_PIn": {
                            "sensor_status": {
                                "lower_operator": "==",
                                "lower_limit": "ok"
                            },
                            "sensor_value": {
                                "lower_operator": ">",
                                "lower_limit": 100
                            }
                        }
                    },
                    "delay_time":125
            }
        }
    },
