{
    "QTNvmeDDCheck": {
        "Desc": "Host Nvme Led test ",
        "Tags": "PromptBox",
        "Module": "interactive_test",
        "Class": "Interactive",
        "Function": "test_nvme_led",
        "Timeout": "360m",
        "Args": [],
        "Kwargs": {
            "NVME NUMBER CHECK": {
                "device": "HOST",
                "prompt_name": "NVME_LED",
                "para": "GREEN",
                "sub_para": "ON",
                "flag": "number",
                "total_nvme_number": 5
            },
            "NVME LED": {
                "device": "HOST",
                "prompt_name": "NVME_LED",
                "para": "GREEN",
                "sub_para": "ON",
                "flag": "",
                "set_cmd": "dd if=/dev/zero of=/dev/nvme{}n1 bs=4k count=100; sleep 3"
            }
        }
    },
